{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "removeComments": true,
    "typeRoots": ["node_modules/@types", "typing-stubs"]
  },
  "include": ["./**/*.ts", "./express-augment.d.ts"],
  "exclude": ["./dist", "./node_modules"]
}
